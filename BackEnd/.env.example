PROJECT_NAME=Scanity API
# Run: python -m scripts.configure_database
# Copy the actual Session pooler host from Supabase; do not guess its region.
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
SECRET_KEY=replace_with_a_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
OLLAMA_HOST=http://localhost:11434
OPENFOODFACTS_API=https://world.openfoodfacts.org/api/v2

# Small pool per running worker, with bounded connection and pool waits.
DATABASE_CONNECT_TIMEOUT=10
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT=10
SUPABASE_URL=https://egnmmylepxdekvtimjaz.supabase.co
