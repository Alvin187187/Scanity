PROJECT_NAME=Scanity API

# Local PostgreSQL
# Used by FastAPI for school development and offline/local demonstrations.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/scanity?sslmode=disable

# Optional Supabase PostgreSQL Session Pooler
# DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require

# Supabase Auth
# Placeholders only. Never commit real keys.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional. Server-side only.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Not used for verification anymore.
# Tokens are checked through the Supabase JWKS endpoint.
# SUPABASE_JWT_SECRET=

SECRET_KEY=replace_with_a_random_secret
JWT_ALGORITHM=ES256
ACCESS_TOKEN_EXPIRE_MINUTES=30

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi4-mini
OPENFOODFACTS_API=https://world.openfoodfacts.org/api/v2

# Hosted Gemini (plain-language explanations only; does not decide avoid/caution/safe)
# Placeholders only. Never commit a real key.
# Google AI Studio key starts with AIza...
# OpenRouter key starts with sk-or-... (auto-routed to OpenRouter Gemini models)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional force: google | openrouter (auto-detected from key prefix when omitted)
# AI_PROVIDER=openrouter

# Optional RAGFlow OpenAPI (https://github.com/infiniflow/ragflow)
# Deploy RAGFlow separately, then set these. Leave blank to use local retrieval.
# RAGFLOW_API_URL=http://localhost:9380
# RAGFLOW_API_KEY=YOUR_RAGFLOW_API_KEY
# RAGFLOW_CHAT_ID=YOUR_CHAT_ID

# Database connection settings
DATABASE_CONNECT_TIMEOUT=10
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT=10

# Browser origins allowed to call this API (comma-separated).
# Include the Vercel production URL. Preview hosts match CORS_ORIGIN_REGEX.
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443,https://scanity-eta.vercel.app
CORS_ORIGIN_REGEX=https://.*\.vercel\.app