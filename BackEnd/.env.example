PROJECT_NAME=Scanity API

# Local PostgreSQL
# Used by FastAPI for school development and offline/local demonstrations.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/scanity

# Supabase
# Variable names only. Never commit real keys.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

SECRET_KEY=replace_with_a_random_secret
JWT_ALGORITHM=ES256
ACCESS_TOKEN_EXPIRE_MINUTES=30

OLLAMA_HOST=http://localhost:11434
OPENFOODFACTS_API=https://world.openfoodfacts.org/api/v2
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=your_supabase_anon_or_publishable_key
# Not used for verification anymore. Tokens are checked via SUPABASE_URL/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_SECRET=

# Database connection settings
DATABASE_CONNECT_TIMEOUT=10
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT=10

OLLAMA_HOST=http://localhost:11434
OPENFOODFACTS_API=https://world.openfoodfacts.org/api/v2

# Database connection settings
DATABASE_CONNECT_TIMEOUT=10
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT=10